<!-- Label Studio Configuration - Voice Helpdesk ASR (Project 5)
     CS203 Assignment 1

     LABEL ORDER: transcript -> intent
     Annotators MUST fill transcript first, then choose intent.
     This prevents intent choice from biasing the transcription.
     See LABELLING_PROTOCOL.md for the rationale.

     Layout: Audio player -> Transcript text area -> Intent choices
-->
<View>
  <Header value="Voice Helpdesk Annotation — CS203 Project 5"/>
  <Audio name="audio" value="$audio" zoom="true" hotkey="space"/>

  <!-- STEP 1: Transcribe the audio clip first -->
  <Header value="Step 1: Transcript (fill this FIRST)"/>
  <TextArea
    name="transcript"
    toName="audio"
    placeholder="Type the transcript in code-mixed English / हिन्दी / ગુજરાતી"
    rows="3"
    editable="true"
    required="true"
    requiredMessage="Transcript is required before choosing intent."
  />

  <!-- STEP 2: Choose intent AFTER completing transcript -->
  <Header value="Step 2: Intent (fill AFTER transcript)"/>
  <Choices
    name="intent"
    toName="audio"
    choice="single"
    required="true"
    requiredMessage="Please select one intent category.">
    <Choice value="admissions"
            hint="Queries about admission process, forms, deadlines, seat availability"/>
    <Choice value="hostel_mess"
            hint="Queries about hostel rooms, mess food, timings, hostel complaints"/>
    <Choice value="it_support"
            hint="Queries about WiFi, email/accounts, software, printers, lab PCs"/>
    <Choice value="student_services"
            hint="Queries about library, health center, transport, student ID cards"/>
  </Choices>
</View>
